# ════════════════════════════════════════════════════════════════
#  MindMate  –  Environment Configuration Template
#  Copy this file to .env and fill in your real values
# ════════════════════════════════════════════════════════════════

# ── Groq LLM  (REQUIRED for AI chatbot) ─────────────────────────
# Free key → https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model — reasoning model (change to llama-3.3-70b-versatile for non-reasoning)
GROQ_MODEL=openai/gpt-oss-120b

# Reasoning effort: low | medium | high  (remove or set to "none" for non-reasoning models)
GROQ_REASONING_EFFORT=medium

# Max tokens in model response
GROQ_MAX_TOKENS=2048

# ── Hugging Face  (optional – local embeddings work without it) ──
# Free token → https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# ── Security ─────────────────────────────────────────────────────
# Change this to a long random string in production
APP_SECRET_KEY=mindmate-change-me-in-production

# Admin panel access code  (used on /admin page)
ADMIN_ACCESS_CODE=mindmate-admin

# ── Paths  (defaults work out of the box – change only if needed) ─
# DATABASE_URL=sqlite:///./mindmate.db
# CHROMA_PERSIST_DIR=./chroma_db
# UPLOAD_DIR=./uploads

# ── CORS origins  (add your deployed frontend URL here) ──────────
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
