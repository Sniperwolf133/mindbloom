# MindMate Backend Environment Configuration
# Copy this file to backend/.env (or .env) and fill in your credentials.
# Never commit .env files with real keys to version control.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Security & App Settings
APP_SECRET_KEY=change-this-to-a-random-secret-string-in-production
DATABASE_URL=sqlite:///./mindmate.db
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

